{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sideglance",
  "version": "../package.json",
  "identifier": "dev.vivekraman.sideglance",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "visible": false,
        "title": "Sideglance",
        "width": 360,
        "height": 220,
        "minWidth": 260,
        "minHeight": 120,
        "resizable": true,
        "alwaysOnTop": true,
        "decorations": true,
        "hiddenTitle": true,
        "acceptFirstMouse": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": {
          "x": 14,
          "y": 18
        },
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-"
    },
    "resources": {
      "resources/skills": "skills",
      "resources/Credits.rtf": "Credits.rtf"
    },
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "A desktop status board for coding agents",
    "longDescription": "Your coding agents, at a glance. Keep agent-reported updates in a compact desktop window, grouped by project and branch."
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBENUMzQzlEODYxOTU0MDcKUldRSFZCbUduVHhjRGFiUE1DVERDbXNpUkFqZXF3RnJCTlBkTVJIbzNoMk0rejN3bHNCUjFGV20K",
      "endpoints": ["https://github.com/Vivek-Raman/sideglance/releases/latest/download/latest.json"]
    }
  }
}
